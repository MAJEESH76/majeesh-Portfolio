---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import manifest from "@data/design-files/manifest.json";

// Why: the list is rendered on the server (works without JS, indexable); the viewer on the
// right is filled by file-viewer.ts from the same manifest, so 3D code only loads on demand.
// Manifest is generated by scripts/sync-design-files.mjs from design-files/.
type FileEntry = (typeof manifest.files)[number];

// Literal class names so the icon CSS pruner keeps them.
const ICONS: Record<string, string> = {
  "cube": "ph ph-cube",
  "cube-focus": "ph ph-cube-focus",
  "compass-tool": "ph ph-compass-tool",
  "rocket-launch": "ph ph-rocket-launch",
  "presentation-chart": "ph ph-presentation-chart",
  "lock-simple": "ph ph-lock-simple",
};

const groups = manifest.groups
  .map((group) => ({ group, files: manifest.files.filter((file) => file.group === group) }))
  .filter(({ files }) => files.length > 0);

const formatSize = (bytes?: number) => {
  if (!bytes) return "";
  return bytes >= 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
};
const first = manifest.files.find((file) => !(file as FileEntry & { restricted?: boolean }).restricted) ?? manifest.files[0];
---

<Section id="files" tone="page" class="file-explorer-section pb-16">
  <Container class="w-full max-w-none px-[clamp(1rem,5vw,5rem)]">
    <div class="mb-8 flex flex-col gap-3">
      <Text tag="p" variant="accent-label">Prototype files</Text>
      <Heading tag="h1" variant="section-title">Design files</Heading>
      <Text variant="lead" class="max-w-3xl">
        Every CAD, drawing and rocket file from my design folder. Pick a file on the left to see it on the right in 2D or 3D.
      </Text>
    </div>

    <div class="file-explorer" data-file-explorer>
      <nav class="file-explorer__list" aria-label="Design files">
        <p class="file-explorer__count">{manifest.files.length} files</p>
        {groups.map(({ group, files }) => (
          <div class="file-explorer__group">
            <p class="file-explorer__group-title">{group} <span>{files.length}</span></p>
            <ul role="list">
              {files.map((file) => (
                <li>
                  <button
                    type="button"
                    class="file-explorer__item"
                    data-file-id={file.id}
                    aria-pressed={file.id === first.id ? "true" : "false"}
                  >
                    <i class:list={[ICONS[file.icon] ?? "ph ph-file", "file-explorer__icon"]} aria-hidden="true"></i>
                    <span class="file-explorer__name">{file.name}</span>
                    <span class="file-explorer__meta">{file.ext}{formatSize((file as FileEntry & { size?: number }).size) && ` · ${formatSize((file as FileEntry & { size?: number }).size)}`}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="file-explorer__viewer" aria-live="polite">
        <div class="file-explorer__toolbar">
          <div class="min-w-0">
            <p class="file-explorer__title" data-viewer-title>{first.name}</p>
            <p class="file-explorer__kind" data-viewer-kind>{first.kind}</p>
          </div>
          <div class="file-explorer__tabs" role="tablist" aria-label="View mode">
            <button type="button" role="tab" data-view-tab="2d" aria-selected="false">2D</button>
            <button type="button" role="tab" data-view-tab="3d" aria-selected="false">3D</button>
          </div>
        </div>
        <div class="file-explorer__stage" data-viewer-stage>
          <p class="file-explorer__placeholder">Loading preview…</p>
        </div>
        <dl class="file-explorer__facts" data-viewer-facts></dl>
        <p class="file-explorer__note" data-viewer-note></p>
      </div>
    </div>
  </Container>
  <script type="application/json" id="design-files-data" set:html={JSON.stringify(manifest)} />
</Section>

<script>
  import { initFileExplorer } from "./file-viewer";

  document.addEventListener("astro:page-load", initFileExplorer);
</script>

<style>
  .file-explorer {
    display: grid;
    gap: 1.5rem;
  }

  .file-explorer__list,
  .file-explorer__viewer {
    min-width: 0;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-lg);
    background: var(--color-surface-bright);
  }

  .file-explorer__list {
    max-height: 22rem;
    overflow-y: auto;
    padding: 0.75rem;
    overscroll-behavior: contain;
  }

  .file-explorer__count {
    margin: 0.25rem 0.5rem 0.5rem;
    color: var(--color-on-surface-variant);
    font-size: 0.8rem;
  }

  .file-explorer__group + .file-explorer__group {
    margin-top: 0.75rem;
  }

  .file-explorer__group-title {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 0.5rem;
    color: var(--color-on-surface-variant);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .file-explorer ul {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .file-explorer__item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.625rem;
    align-items: center;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    border-radius: var(--ui-radius-md, 0.5rem);
    background: transparent;
    color: var(--color-on-surface);
    text-align: left;
    cursor: pointer;
  }

  .file-explorer__item:hover {
    background: var(--color-surface-container-low);
  }

  .file-explorer__item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .file-explorer__item[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .file-explorer__icon {
    grid-row: span 2;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--color-surface-container);
    color: var(--color-on-surface);
    font-size: 1.15rem;
  }

  .file-explorer__item[aria-pressed="true"] .file-explorer__icon {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .file-explorer__name {
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-explorer__meta {
    color: inherit;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .file-explorer__viewer {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .file-explorer__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .file-explorer__title {
    margin: 0;
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-explorer__kind {
    margin: 0;
    color: var(--color-on-surface-variant);
    font-size: 0.85rem;
  }

  .file-explorer__tabs {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--color-surface-container);
  }

  .file-explorer__tabs button {
    min-width: 3.25rem;
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-on-surface);
    font-weight: 700;
    cursor: pointer;
  }

  .file-explorer__tabs button[aria-selected="true"] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .file-explorer__tabs button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .file-explorer__stage {
    position: relative;
    display: grid;
    min-height: clamp(18rem, 55vw, 34rem);
    place-items: center;
    overflow: hidden;
    background: #2f2e5a;
    color: #f1efe9;
  }

  .file-explorer__stage :global(img) {
    display: block;
    max-width: 100%;
    max-height: clamp(18rem, 55vw, 34rem);
    object-fit: contain;
  }

  .file-explorer__stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    cursor: grab;
  }

  .file-explorer__stage :global(svg) {
    width: 100%;
    height: auto;
    max-height: clamp(18rem, 55vw, 34rem);
  }

  .file-explorer__placeholder {
    max-width: 28rem;
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    line-height: 1.5;
    opacity: 0.85;
  }

  .file-explorer__stage :global(.file-explorer__hint) {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    font-size: 0.75rem;
  }

  .file-explorer__stage :global(.file-explorer__thumbs) {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    max-width: calc(100% - 1.5rem);
    gap: 0.375rem;
    overflow-x: auto;
  }

  .file-explorer__stage :global(.file-explorer__thumbs button) {
    flex: 0 0 auto;
    width: 3.5rem;
    height: 2.5rem;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 0.375rem;
    background: #000;
    cursor: pointer;
  }

  .file-explorer__stage :global(.file-explorer__thumbs button[aria-current="true"]) {
    border-color: var(--color-accent);
  }

  .file-explorer__stage :global(.file-explorer__thumbs img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-explorer__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 1rem 1.25rem 0;
  }

  .file-explorer__facts :global(dt) {
    color: var(--color-on-surface-variant);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .file-explorer__facts :global(dd) {
    margin: 0.125rem 0 0;
    font-weight: 600;
  }

  .file-explorer__note {
    margin: 0;
    padding: 0.75rem 1.25rem 1.25rem;
    color: var(--color-on-surface-variant);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .file-explorer__note:empty {
    display: none;
  }

  @media (min-width: 64rem) {
    .file-explorer {
      grid-template-columns: minmax(18rem, 22rem) minmax(0, 1fr);
      align-items: start;
    }

    .file-explorer__list {
      position: sticky;
      top: calc(var(--site-header-height, 5.75rem) + 1rem);
      max-height: calc(100vh - var(--site-header-height, 5.75rem) - 2rem);
    }
  }
</style>
